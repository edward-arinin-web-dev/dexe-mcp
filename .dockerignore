# The image copies package*.json, tsconfig.json, src/, scripts/bundle-read.mjs,
# docs/GRAPH.md and LICENSE only; this keeps the build context small and makes
# sure no local secrets reach the Docker daemon.
.env
.env.*
!.env.example
.git
.github
.claude
.claude-plugin
node_modules
dist
coverage
tests
internal
research
scripts/*
!scripts/bundle-read.mjs
assets
dexe-plugin
docs/*
!docs/GRAPH.md
plans
reports
*.log
*.tgz
