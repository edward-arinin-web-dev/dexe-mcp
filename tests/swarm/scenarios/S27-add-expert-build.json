{
  "id": "S27-add-expert-build",
  "title": "Build Add Expert proposals (local + global modes)",
  "priority": 2,
  "dao": "{{firstAllowlistedDao}}",
  "dependsOn": [],
  "requiresChain": [56, 97],
  "requiresBrowser": false,
  "notes": "Two builds: local ExpertNft.mint and global DeXeExpertNft.mint. Both NFT addresses come from {{dao.expertNft}} / {{dao.dexeExpertNft}} (GovPool.getNftContracts()), so the scenario follows the DAO allowlist instead of pinning a dead fixture's helpers.",
  "agents": [{ "alias": "A", "role": "Voter1/Delegator", "wallet": "AGENT_PK_2" }],
  "steps": [
    {
      "step": 1,
      "agent": "A",
      "tool": "dexe_proposal_build_add_expert",
      "args": {
        "expertNftContract": "{{dao.expertNft}}",
        "scope": "local",
        "nominatedUser": "0x7340b46959f4598f86aA23D5d26ec289e2736e77",
        "uri": "ipfs://QmExpertCV",
        "proposalName": "S27 add local expert"
      },
      "broadcast": false,
      "captureAs": "builtLocal"
    },
    {
      "step": 2,
      "agent": "A",
      "tool": "dexe_proposal_build_add_expert",
      "args": {
        "expertNftContract": "{{dao.dexeExpertNft}}",
        "scope": "global",
        "nominatedUser": "0x7340b46959f4598f86aA23D5d26ec289e2736e77",
        "proposalName": "S27 add global expert"
      },
      "broadcast": false,
      "captureAs": "builtGlobal"
    }
  ],
  "successCriteria": [{ "id": "two-builds", "check": "builtLocal + builtGlobal both encode mint actions" }]
}
