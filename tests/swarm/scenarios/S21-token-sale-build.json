{
  "id": "S21-token-sale-build",
  "title": "Build a Token Sale (single tier) proposal",
  "priority": 2,
  "dao": "{{firstAllowlistedDao}}",
  "dependsOn": [],
  "requiresChain": [56, 97],
  "requiresBrowser": false,
  "notes": "TokenSaleProposal.createTiers single-tier path. tokenSaleProposal comes from {{dao.tokenSale}} (SWARM_TOKENSALE_<tag>, index-parallel to SWARM_DAOS_<tag>) — GovPool has no forward getter for it.",
  "agents": [{ "alias": "A", "role": "Voter1/Delegator", "wallet": "AGENT_PK_2" }],
  "steps": [
    {
      "step": 1,
      "agent": "A",
      "tool": "dexe_proposal_build_token_sale",
      "args": {
        "tokenSaleProposal": "{{dao.tokenSale}}",
        "tier": {
          "name": "S21 tier",
          "totalTokenProvided": "1000000000000000000000",
          "saleStartTime": "{{now-3600}}",
          "saleEndTime": "{{now+2592000}}",
          "saleTokenAddress": "{{firstAllowlistedToken}}",
          "purchaseTokenAddresses": ["{{firstAllowlistedToken}}"],
          "exchangeRates": ["1000000000000000000"]
        },
        "proposalName": "S21 token sale tier sanity"
      },
      "broadcast": false,
      "captureAs": "built"
    }
  ],
  "successCriteria": [{ "id": "tier-encoded", "check": "built has createTiers action" }]
}
