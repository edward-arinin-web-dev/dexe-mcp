{
  "id": "S13-multi-proposal-state",
  "title": "Multi-proposal lifecycle snapshot across both fixture DAOs",
  "priority": 2,
  "dao": "{{firstAllowlistedDao}}",
  "dependsOn": [],
  "requiresChain": [56, 97],
  "requiresBrowser": false,
  "notes": "HISTORY-AGNOSTIC. This scenario used to pin literal proposal ids (1, 2 on daos[0]; 1, 4, 5 on daos[1]) and assert the exact states a 2026-04 smoke test left behind. Those reads keep answering on a DE-REGISTERED pool, so S13 stayed green while every write scenario failed the W10 guard — and it would have flipped to red the moment the allowlist was repointed at fresh DAOs with zero proposals. It now discovers ids through dexe_proposal_list and asserts the INVARIANT (the state is one of the canonical IGovPool.ProposalState names, the id round-trips) instead of a snapshot. Also exercises dexe_proposal_list for paged reads.",
  "agents": [
    { "alias": "A", "role": "Voter1/Delegator", "wallet": "AGENT_PK_2" }
  ],
  "steps": [
    {
      "step": 1,
      "agent": "A",
      "tool": "dexe_proposal_list",
      "args": { "govPool": "{{firstAllowlistedDao}}", "offset": 0, "limit": 5 },
      "broadcast": false,
      "captureAs": "listFirst",
      "expect": [
        { "path": "listFirst.govPool", "op": "eq", "value": "{{firstAllowlistedDao}}" },
        { "path": "listFirst.proposals", "op": "present" }
      ]
    },
    {
      "step": 2,
      "agent": "A",
      "tool": "dexe_proposal_state",
      "args": { "govPool": "{{firstAllowlistedDao}}", "proposalId": "{{listFirst.proposals.0.proposalId}}" },
      "broadcast": false,
      "captureAs": "first1",
      "skipIf": "listFirst.proposals.length == 0",
      "expect": [
        {
          "path": "first1.state",
          "op": "in",
          "value": [
            "Voting",
            "WaitingForVotingTransfer",
            "ValidatorVoting",
            "Defeated",
            "SucceededFor",
            "SucceededAgainst",
            "Locked",
            "ExecutedFor",
            "ExecutedAgainst"
          ],
          "note": "IGovPool.ProposalState minus Undefined — an existing proposal is never Undefined."
        }
      ]
    },
    {
      "step": 3,
      "agent": "A",
      "tool": "dexe_proposal_list",
      "args": { "govPool": "{{secondAllowlistedDao}}", "offset": 0, "limit": 5 },
      "broadcast": false,
      "captureAs": "listSecond",
      "expect": [
        { "path": "listSecond.govPool", "op": "eq", "value": "{{secondAllowlistedDao}}" },
        { "path": "listSecond.proposals", "op": "present" }
      ]
    },
    {
      "step": 4,
      "agent": "A",
      "tool": "dexe_proposal_state",
      "args": { "govPool": "{{secondAllowlistedDao}}", "proposalId": "{{listSecond.proposals.0.proposalId}}" },
      "broadcast": false,
      "captureAs": "second1",
      "skipIf": "listSecond.proposals.length == 0",
      "expect": [
        {
          "path": "second1.state",
          "op": "in",
          "value": [
            "Voting",
            "WaitingForVotingTransfer",
            "ValidatorVoting",
            "Defeated",
            "SucceededFor",
            "SucceededAgainst",
            "Locked",
            "ExecutedFor",
            "ExecutedAgainst"
          ]
        }
      ]
    }
  ],
  "successCriteria": [
    { "id": "list-answers", "check": "dexe_proposal_list returns a well-formed proposals array for both fixture DAOs" },
    { "id": "state-canonical", "check": "every state read back is one of the canonical IGovPool.ProposalState names" }
  ]
}
